+// A digital channel's TX after an FM channel with a receive tone (gotchas 3.18): power on on digital channel A, key a
+// burst; then the radio's own sequence for a channel change or scan that passes an FM channel with a CTCSS or DCS
+// receive tone and stops on digital channel B; key a burst there. 0x51 must be as it was on A: its bit 15 also turns on
+// the sub-audio transmitter, which put the tone on the 4FSK of every DMR, NXDN, P25 and YSF burst
+static void test_dmr_tone_off(void)
+{
+	static const struct { fd6818_tone_t type; uint16_t value; } tones[] = {
+		{ FD6818_TONE_CTCSS, 1000 }, { FD6818_TONE_DCS, 023 }, { FD6818_TONE_DCS_INV, 0754 },
+	};
+	for (unsigned t = 0; t < sizeof tones / sizeof tones[0]; t++) {
+		fd6818_t dev;
+		reset_chip();
+		fd6818_attach(&dev, bus());
+		fd6818_init(&dev);
+		fd6818_set_mode(&dev, FD6818_MODE_DMR);		// power-on channel A, digital
+		fd6818_set_freq(&dev, 438500000u);
+		fd6818_set_state(&dev, FD6818_STATE_RX);
+		fd6818_dmr_burst_at(&dev, true, FD6818_BW_DMR, 438500000u);
+		uint16_t boot = chip.regs[FD6818_REG_SUBAUDIO];
+		CHECK((boot & 0x8000u) == 0);
+		fd6818_dmr_burst_at(&dev, false, FD6818_BW_DMR, 438500000u);
+
+		fd6818_set_mode(&dev, FD6818_MODE_FM);		// an FM channel with a receive tone on the way
+		fd6818_set_freq(&dev, 446000000u);
+		fd6818_set_rx_tone(&dev, tones[t].type, tones[t].value);
+		fd6818_set_state(&dev, FD6818_STATE_RX);
+		CHECK((chip.regs[FD6818_REG_SUBAUDIO] & 0x8000u) != 0);
+
+		fd6818_set_mode(&dev, FD6818_MODE_DMR);		// channel B, digital: PTT
+		fd6818_set_freq(&dev, 439000000u);
+		fd6818_set_state(&dev, FD6818_STATE_RX);
+		fd6818_dmr_burst_at(&dev, true, FD6818_BW_DMR, 439000000u);
+		CHECK((chip.regs[FD6818_REG_SUBAUDIO] & 0x8000u) == 0);
+		CHECK(chip.regs[FD6818_REG_SUBAUDIO] == boot);
+		CHECK(chip.protocol_errors == 0);
+	}
+}
