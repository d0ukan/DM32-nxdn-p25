+static ysf_engine_t yfar;
+static bool yfar_running, yfar_tx;
+
+static bool yfar_ambe(uint8_t vch[9], void *ctx)
+{
+	(void)ctx;
+	memcpy(vch, dmr_ambe_silence, 9);
+	return true;
+}
+
+static bool yfar_imbe(uint8_t imbe[FEC_IMBE88_BYTES], void *ctx)
+{
+	(void)ctx;
+	memcpy(imbe, imbe_silence, FEC_IMBE88_BYTES);
+	return true;
+}
+
+static const ysf_engine_hooks_t yfar_hooks = { .tx_voice = yfar_ambe, .tx_vw = yfar_imbe };
+
+static void yfar_begin(uint8_t dt)
+{
+	ysf_engine_cfg_t c = { .dt = dt, .narrow = false, .silence = dmr_ambe_silence,
+		.silence_vw = imbe_silence };
+
+	if (yfar_running)
+		ysf_engine_end(&yfar);
+	memset(c.dest, ' ', sizeof c.dest);
+	memset(c.src, ' ', sizeof c.src);
+	memcpy(c.dest, "ALL", 3);
+	memcpy(c.src, "XE1XYZ", 6);
+	yfar_tx = false;
+	yfar_running = ysf_engine_begin(&yfar, &fake_air1, &c, &yfar_hooks, NULL);
+	CHECK(yfar_running);
+}
+
+static void yfar_start(void)
+{
+	CHECK(ysf_engine_tx_prepare(&yfar) && ysf_engine_tx_go(&yfar));
+	yfar_tx = true;
+}
+
+static void yfar_finish(void)
+{
+	ysf_engine_tx_abort(&yfar);
+	for (int i = 0; i < 50 && yfar_tx; i++)
+		run(10);
+	CHECK(!yfar_tx);
+	for (int i = 0; i < 200 && (sm.view.ysf.flags & RADIO_YSF_RX); i++)
+		run(20);
+	CHECK((sm.view.ysf.flags & RADIO_YSF_RX) == 0);
+}
+
+static void yfar_stop(void)
+{
+	if (yfar_running) {
+		ysf_engine_end(&yfar);
+		yfar_running = yfar_tx = false;
+	}
+}
+
+static void yfar_step(void)
+{
+	if (yfar_tx && ysf_engine_tx_state(&yfar) == AIR_TX_DONE) {
+		ysf_engine_tx_clear(&yfar);
+		yfar_tx = false;
+	}
+}
