+static void test_ysf_cross_dt_rx(void)
+{
+	static const uint8_t configured[] = { YSF_DT_VOICE_FR, YSF_DT_VD_MODE2 };
+
+	for (unsigned i = 0; i < sizeof configured / sizeof configured[0]; i++) {
+		uint8_t incoming = configured[i] == YSF_DT_VOICE_FR ? YSF_DT_VD_MODE2 : YSF_DT_VOICE_FR;
+		dmr_start(true);
+		sm.set.talk_permit = false;
+		cp_radio_name = "xe1abc";
+		req(RREQ_VFO, 1);
+		radio_ysf_settings_t y;
+		radio_ysf_settings(&y);
+		y.dt = configured[i];
+		y.narrow = false;
+		radio_req_ysf_settings(&y);
+		req(RREQ_MODE, RADIO_MODE_YSF);
+		CHECK(radio_ysf_running());
+		radio_ysf_reset_stats();
+		ambeVoiceResetStats();
+		p25VoiceResetStats();
+		aud.feed = true;
+		yfar_begin(incoming);
+		yfar_start();
+		run(700);
+		radio_ysf_stats_t st;
+		radio_ysf_stats(&st);
+		CHECK(st.rx_calls == 1 && sm.view.ysf.dt == incoming);
+		CHECK(st.voice > 0);
+		CHECK((sm.view.ysf.flags & RADIO_YSF_PLAYED) != 0);
+		if (incoming == YSF_DT_VOICE_FR) {
+			p25_voice_stats_t v;
+			p25VoiceGetStats(&v);
+			CHECK(v.rx_frames > 0);
+		} else {
+			ambe_voice_stats_t v;
+			ambeVoiceGetStats(&v);
+			CHECK(v.rx_frames > 0);
+		}
+		yfar_finish();
+		run(100);
+		radio_ysf_stats(&st);
+		uint32_t tx_calls = st.tx_calls;
+		req(RREQ_PTT, 1);
+		run(300);
+		CHECK(sm.view.state == RS_TX);
+		req(RREQ_PTT, 0);
+		run(700);
+		radio_ysf_stats(&st);
+		CHECK(st.tx_calls == tx_calls + 1 && st.tx_pcm_fails == 0);
+
+		// The configured path is restored for the next call, too.
+		uint32_t voice = st.voice;
+		yfar_begin(configured[i]);
+		yfar_start();
+		run(700);
+		radio_ysf_stats(&st);
+		CHECK(st.voice > voice && (sm.view.ysf.flags & RADIO_YSF_PLAYED) != 0);
+		yfar_finish();
+		yfar_stop();
+		run(100);
+		radio_ysf_end();
+		aud.feed = false;
+		cp_radio_name = "";
+	}
 }
 #endif
 
