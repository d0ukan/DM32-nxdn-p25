+
+static bool voice_start(uint8_t path)
+{
+#if CONFIG_P25 && CONFIG_IMBE
+	if (path == YSF_PATH_VW) {
+		p25_voice_mem_t *mem = vw_mem_get();
+
+		if (mem == NULL)
+			return false;
+		p25VoiceBegin(mem, YSF_BLOCKS);
+		return true;
+	}
+#endif
+	if (path == YSF_PATH_AMBE) {
+		ambeVoiceStart();
+		return true;
+	}
+	return false;
+}
+
+// Serialize all vocoder and stream ownership changes in the radio task. The
+// configured TX path is restored whenever no receive voice call owns it.
+static void voice_poll(void)
+{
+	uint32_t seq = __atomic_load_n(&rx_seq, __ATOMIC_ACQUIRE);
+	uint8_t request = __atomic_load_n(&rx_request, __ATOMIC_ACQUIRE);
+	uint8_t active = __atomic_load_n(&rx_path, __ATOMIC_ACQUIRE);
+	uint8_t owner = __atomic_load_n(&voice_path, __ATOMIC_ACQUIRE);
+	uint8_t desired = request == YSF_PATH_NONE ? configured_path() : request;
+
+	if (active != YSF_PATH_NONE && (seq != rx_handled || active != request)) {
+		if (active == YSF_PATH_AMBE) {
+			const dmr_voice_sink_t *s = ambeVoiceSink();
+			s->end(s->ctx);
+		}
+#if CONFIG_P25 && CONFIG_IMBE
+		else if (active == YSF_PATH_VW) {
+			p25VoiceHooks()->rx_end(NULL);
+		}
+#endif
+		__atomic_store_n(&rx_path, YSF_PATH_NONE, __ATOMIC_RELEASE);
+	}
+	rx_handled = seq;
+	if (owner != desired && __atomic_load_n(&voice_failed, __ATOMIC_ACQUIRE) != desired) {
+		if (owner != YSF_PATH_NONE)
+			voice_end(owner == YSF_PATH_VW);
+		__atomic_store_n(&voice_path, YSF_PATH_NONE, __ATOMIC_RELEASE);
+		if (voice_start(desired)) {
+			__atomic_store_n(&voice_path, desired, __ATOMIC_RELEASE);
+			__atomic_store_n(&voice_failed, YSF_PATH_NONE, __ATOMIC_RELEASE);
+		} else {
+			__atomic_store_n(&voice_failed, desired, __ATOMIC_RELEASE);
+		}
+	}
+	if (request != YSF_PATH_NONE && __atomic_load_n(&rx_path, __ATOMIC_ACQUIRE) == YSF_PATH_NONE &&
+	    __atomic_load_n(&voice_path, __ATOMIC_ACQUIRE) == request) {
+		if (request == YSF_PATH_AMBE) {
+			const dmr_voice_sink_t *s = ambeVoiceSink();
+			s->begin(NULL, s->ctx);
+		}
+#if CONFIG_P25 && CONFIG_IMBE
+		else if (request == YSF_PATH_VW) {
+			p25VoiceHooks()->rx_start(NULL, NULL);
+		}
+#endif
+		__atomic_store_n(&rx_path, request, __ATOMIC_RELEASE);
+	}
+#if CONFIG_P25 && CONFIG_IMBE
+	if (__atomic_load_n(&voice_path, __ATOMIC_ACQUIRE) == YSF_PATH_VW)
+		p25VoicePoll();
+#endif
 }
 
