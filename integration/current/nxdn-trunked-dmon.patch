diff --git a/tests/host/nxdnTest.c b/tests/host/nxdnTest.c
index ed78f66..030d3f5 100644
--- a/tests/host/nxdnTest.c
+++ b/tests/host/nxdnTest.c
@@ -397,6 +397,27 @@ static void testCalls(void)
 	st = receive(&nxdn_air_mode_9600, 7, 0, true);
 	CHECK(got.starts == 1 && got.ends == 1 && got.voice == 16 && voice_in_order(0, 16) && st.facch_fail == 0,
 	      "9600: starts %u voice %u facch fails %u", got.starts, got.voice, st.facch_fail);
+
+	// A trunked traffic channel labels the same voice frames RTCH instead of RDCH. Keep parity, USC and RAN intact.
+	for (uint32_t at = call_at + NXDN_PREAMBLE_SYMS; at < call_at + NXDN_PREAMBLE_SYMS + 9 * NXDN_FRAME_SYMS;
+	     at += NXDN_FRAME_SYMS) {
+		uint8_t frame[NXDN_FRAME_BYTES] = { 0 };
+		for (uint16_t i = 0; i < NXDN_FRAME_SYMS; i++) {
+			air_sym_put(frame, i, tx_air[at + i]);
+		}
+		int lich = nxdn_lich_get(frame, NULL);
+		CHECK(lich >= 0 && NXDN_LICH_RF(lich) == NXDN_RF_RDCH, "RTCH setup LICH");
+		nxdn_frame_begin(frame, NXDN_LICH(NXDN_RF_RTCH, NXDN_LICH_USC(lich), NXDN_LICH_OPT(lich),
+		                                 NXDN_LICH_DIR(lich)));
+		for (uint16_t i = 0; i < NXDN_FRAME_SYMS; i++) {
+			tx_air[at + i] = air_sym_get(frame, i);
+		}
+	}
+	st = receive(&nxdn_air_mode_9600, 7, 0, true);
+	CHECK(got.starts == 1 && got.ends == 1 && got.voice == 16 && voice_in_order(0, 16) && st.lich_fail == 0 &&
+	      st.facch_fail == 0 && st.sacch_fail == 0,
+	      "NXDN96 RTCH: %u/%u/%u, fails %u/%u/%u", got.starts, got.ends, got.voice,
+	      st.lich_fail, st.facch_fail, st.sacch_fail);
 }
 
