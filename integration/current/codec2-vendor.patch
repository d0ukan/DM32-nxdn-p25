+    Spare                           0        1         1
+    TOTAL                          10       38        48
+
+\*---------------------------------------------------------------------------*/
+
+void codec2_encode_1200(struct CODEC2 *c2, unsigned char *bits,
+                        short speech[]) {
+  MODEL model;
+  float lsps[LPC_ORD];
