+
+    Parameter                      frame 2  frame 4   Total
+    -------------------------------------------------------
+    Harmonic magnitudes (LSPs)      0       36        36
+    Energy+Wo                       8        8        16
+    Voicing (10ms update)           2        2         4
+    TOTAL                          10       46        56
+
+\*---------------------------------------------------------------------------*/
+
+void codec2_encode_1400(struct CODEC2 *c2, unsigned char *bits,
+                        short speech[]) {
+  MODEL model;
+  float lsps[LPC_ORD];
+  float ak[LPC_ORD + 1];
+  float e;
+  int lsp_indexes[LPC_ORD];
+  int WoE_index;
+  int i;
